# PostgreSQL
POSTGRES_DB=vpnpanel
POSTGRES_USER=vpnpanel
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://vpnpanel:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/vpnpanel

# Automated PostgreSQL backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=14
BACKUP_RETRY_SECONDS=300
BACKUP_VERIFY_RESTORE=true
BACKUP_HEALTH_MAX_AGE_MINUTES=1560

# Authentication
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=30
CLIENT_TOKEN_EXPIRE_MINUTES=10080
CLIENT_COOKIE_SECURE=true

# Production API
API_DOCS_ENABLED=false
PUBLIC_BASE_URL=https://dlgtw.ru
ADMIN_LOGIN_RATE_LIMIT=10
ADMIN_LOGIN_RATE_WINDOW_SECONDS=600
ADMIN_2FA_CHALLENGE_EXPIRE_MINUTES=5
PUBLIC_ORDER_RATE_LIMIT=20
PUBLIC_ORDER_RATE_WINDOW_SECONDS=3600

# External services and caching
DASHBOARD_CACHE_TTL=15
XUI_REQUEST_TIMEOUT=8

# Optional server-side availability monitor (start service vpn-monitor)
VPN_MONITOR_INTERVAL_SECONDS=3600
VPN_MONITOR_CONFIRM_SECONDS=60
